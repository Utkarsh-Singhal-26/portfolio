# Empty in production; http://localhost:3000 for local dev.
NEXT_PUBLIC_BASE_URL=
# Set in production — open-source section needs this (REST fallback is rate-limited without it).
GITHUB_TOKEN=
# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview). Set in production.
NEXT_PUBLIC_CLARITY_ID=
# PostHog project API key (PostHog → Project settings). Set in production.
NEXT_PUBLIC_POSTHOG_KEY=
# Upstash Redis REST creds (upstash.com → Redis → REST API) for the visitor counter. Set in production; local dev uses a file.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# WakaTime OAuth token (same secret the profile README workflow uses). Optional: without it the coding-time figure on /activity is hidden.
WAKATIME_OAUTH_TOKEN=
